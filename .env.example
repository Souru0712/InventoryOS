# --- core ---
APP_ENV=dev                   # dev | staging | production
APP_BASE_URL=http://localhost:8000
SECRET_KEY=change-me-openssl-rand-hex-32
# A session ends after this long without a request, and this many days after sign-in.
SESSION_IDLE_MINUTES=720
SESSION_MAX_DAYS=14
# Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Build or commit id, attached to error reports.
RELEASE=

# --- database ---
DATABASE_URL=sqlite:///./stockpulse.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/stockpulse   (postgres:// also accepted)

# --- scheduled jobs ---
# Dev runs them inside the web process; staging and production need `python -m app.cli scheduler`.
# RUN_SCHEDULER_IN_WEB=false

# --- square ---
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_ENV=sandbox            # sandbox | production
SQUARE_API_VERSION=2025-01-23
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WRITE_BACK=false       # C-34: stays off until R1.1's outbox

# --- email (SMTP; leave blank to log instead of send) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="StockPulse <alerts@yourdomain.com>"
SUPPORT_EMAIL=you@yourdomain.com

# --- invoice photo extraction ---
ANTHROPIC_API_KEY=
EXTRACTOR_MODEL=claude-opus-5
MAX_UPLOAD_MB=15

# --- invoice photo storage ---
STORAGE_BACKEND=local         # local | s3
UPLOAD_DIR=var/uploads        # local: must be a persistent volume when deployed
S3_BUCKET=
S3_ENDPOINT_URL=              # blank for AWS; set for R2, Backblaze, Spaces, MinIO
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=uploads

# --- error monitoring ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- sync and tuning ---
SYNC_INTERVAL_MINUTES=60
ALERT_COOLDOWN_HOURS=24
# How far ahead stock that will not sell before its date is raised.
EXPIRY_HORIZON_DAYS=30
